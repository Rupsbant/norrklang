---
import Mark from './Mark.astro';
import { GITHUB_URL, SITE_NAME } from '../config';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="wordmark">
      <Mark size={28} />
      {SITE_NAME}
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a class="site-nav__section" href="/#features">Features</a>
      <a class="site-nav__section" href="/#requirements">Requirements</a>
      <a class="site-nav__support" href="/#support">
        {/* Material "favorite" outline, 24px grid. */}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20.3l-1.2-1.1C5.4 14.4 2 11.3 2 7.5 2 4.4 4.4 2 7.5 2c1.7 0 3.4.8 4.5 2.1C13.1 2.8 14.8 2 16.5 2 19.6 2 22 4.4 22 7.5c0 3.8-3.4 6.9-8.8 11.7L12 20.3z" />
        </svg>
        Support
      </a>
      <a href={GITHUB_URL}>
        {/* GitHub's mark (Octicons, MIT), used as GitHub's logo guidelines allow: to link to GitHub. */}
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
        GitHub
      </a>
    </nav>
  </div>
</header>
